# Required for production / normal use
SIEM_SESSION_SECRET=replace-with-long-random-string

# Local demo only (allows default session secret — do not use in production)
# SIEM_ALLOW_INSECURE=true

# Database
# SIEM_DB_PATH=siem.db

# Sync lookback window (minutes)
# SIEM_SYNC_MINUTES=15

# Cookie secure flag (set true behind HTTPS)
# SIEM_SESSION_HTTPS_ONLY=false

# Optional bootstrap admin (if no users exist)
# SIEM_ADMIN_USERNAME=admin
# SIEM_ADMIN_SALT=
# SIEM_ADMIN_PASSWORD_HASH=
# SIEM_PBKDF2_ITERATIONS=210000

# Tenant client secrets (referenced from Manage Tenants UI)
# TENANT_A_CLIENT_SECRET=

# Alert email
# ALERT_EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# SMTP_USE_TLS=true

# OpenClawAI webhook
# OPENCLAWAI_ENABLED=false
# OPENCLAWAI_URL=
# OPENCLAWAI_API_KEY=
# OPENCLAWAI_TIMEOUT=10

# SSO via reverse-proxy headers
# SIEM_SSO_ENABLED=false
# SIEM_SSO_USER_HEADER=X-Auth-Request-User
# SIEM_SSO_ROLE_HEADER=X-Auth-Request-Role
# SIEM_SSO_MFA_HEADER=X-Auth-Request-Amr
# SIEM_SSO_REQUIRE_MFA=true

# GitHub update check
# SIEM_GITHUB_REPO=NyetNighy/Local_Hosted_SIEM
# SIEM_GITHUB_BRANCH=main
