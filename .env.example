# Required for production / normal use
SIEM_SESSION_SECRET=replace-with-long-random-string

# Local demo only
# SIEM_ALLOW_INSECURE=true

# SIEM_DB_PATH=siem.db
# SIEM_SYNC_MINUTES=15
# SIEM_SESSION_HTTPS_ONLY=false

# YAML detection rules (default: rules/detections.yaml)
# DETECTION_RULES_PATH=rules/detections.yaml

# Alert email (see docs/email-alerting.md)
ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_MIN_SEVERITY=medium
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=siem-alerts@example.com
# SMTP_TO=soc@example.com,oncall@example.com

# Microsoft Teams incoming webhook
# TEAMS_WEBHOOK_ENABLED=true
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Slack incoming webhook
# SLACK_WEBHOOK_ENABLED=true
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_MIN_SEVERITY=medium
# WEBHOOK_TIMEOUT=10

# OPENCLAWAI_ENABLED=false
# OPENCLAWAI_URL=
# OPENCLAWAI_API_KEY=

# SIEM_SSO_ENABLED=false
# SIEM_GITHUB_REPO=NyetNighy/Local_Hosted_SIEM
